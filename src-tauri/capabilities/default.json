{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "TOY Office desktop window permissions for file dialogs and editor events",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message"
  ]
}
